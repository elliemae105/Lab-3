    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Manual CPU</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString># Testing the manual CPU
# CLK: Clock
# ALUOP: ALU opcode
#    00 - AND, 01 - ORR, 10 - ADD, 11 - SUB
# RS1: First operand
# RS2: Second operand
# WS: Destination register to write to
# WE: (Register) Write enable
# STR: Store
# LDR: Load
# R1-R4: Registers
# DATA: Output from Data Multiplexer
#  01 - ALU, 10 - MEMORY, 11-INPUT, 00-X
# IN: Manual data input
CLK ALUOP RS1 RS2 WS WE STR LDR IN DMUX    R1 R2 R3     R4     DATA

0   0     0   0   0  0  0   0   0  x       x  x  x      x      x      # registers uninitalised
C   x     x   x   1  1  0   0   1  3       1  x  x      x      1      # R1 := 1
C   x     x   x   2  1  0   0   2  3       1  2  x      x      2      # R2 := 2
C   x     0   x   3  1  0   1   0  2       1  2  0xAAAA x      0xAAAA # R3 := mem[RZ]
C   x     1   x   4  1  0   1   0  2       1  2  0xAAAA 0xBBBB 0xBBBB # R4 := mem[R1]
C   2     3   4   4  1  0   0   0  1       1  2  0xAAAA 0x6665 x      # R4 := R4 + R3
C   x     2   4   x  0  1   0   0  x       1  2  0xAAAA 0x6665 x      # mem[R2] := R4
C   x     2   x   x  0  0   1   0  2       1  2  0xAAAA 0x6665 0x6665 # check mem[R2] := R4

program(0xAAAA, 0xBBBB, 0xCCCC, 0xDDDD)
</dataString>
          </testData>
        </entry>
      </elementAttributes>
