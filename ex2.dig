    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>RESULT</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>ALUOP A B RESULT

# Test small results
loop(a, 1 &lt;&lt; 4)
  loop(b, 1 &lt;&lt; 4)
    (0b000) (a) (b) ((a + b) &amp; 0xFFFF)   # ADD
    (0b001) (a) (b) ((a - b) &amp; 0xFFFF)   # SUB
    (0b010) (a) (b) (~(a &amp; b) &amp; 0xFFFF)  # NAND
    (0b011) (a) (b) (~(a | b) &amp; 0xFFFF)  # NOR
    (0b100) (a) (b) (a &amp; b)              # AND
    (0b101) (a) (b) (a | b)              # ORR
    (0b110) (a) (b) (a ^ b)              # XOR
    (0b111) (a) (b) (~a &amp; 0xFFFF)        # NOT
  end loop
end loop


# Test large results
loop(i, 1000)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);

    (0b000) (a) (b) ((a + b) &amp; 0xFFFF)   # ADD
    (0b001) (a) (b) ((a - b) &amp; 0xFFFF)   # SUB
    (0b010) (a) (b) (~(a &amp; b) &amp; 0xFFFF)  # NAND
    (0b011) (a) (b) (~(a | b) &amp; 0xFFFF)  # NOR
    (0b100) (a) (b) (a &amp; b)              # AND
    (0b101) (a) (b) (a | b)              # ORR
    (0b110) (a) (b) (a ^ b)              # XOR
    (0b111) (a) (b) (~a &amp; 0xFFFF)        # NOT
end loop
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-300" y="60"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Z</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>ALUOP A B Z

declare Z = FLAG &amp; 0b1;

# Test all zero cases
0b000 0 0 1 # AND
0b001 0 0 1 # SUB
0b010 0 0 0 # NAND
0b011 0 0 0 # NOR
0b100 0 0 1 # AND
0b101 0 0 1 # ORR
0b110 0 0 1 # XOR
0b111 0 0 0 # NOT

# Test 1 + (-1) = 0
0b000 1 0xFFFF 1

# Test random inputs
loop(i, 200)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);

    (0b000) (a) (b) (((a + b) &amp; 0xFFFF) = 0)   # ADD
    (0b001) (a) (b) (((a - b) &amp; 0xFFFF) = 0)   # SUB
    (0b010) (a) (b) ((~(a &amp; b) &amp; 0xFFFF) = 0)  # NAND
    (0b011) (a) (b) ((~(a | b) &amp; 0xFFFF) = 0)  # NOR
    (0b100) (a) (b) ((a &amp; b) = 0)              # AND
    (0b101) (a) (b) ((a | b) = 0)              # ORR
    (0b110) (a) (b) ((a ^ b) = 0)              # XOR
    (0b111) (a) (b) ((~a) &amp; 0xFFFF = 0)        # NOT
end loop</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-300" y="160"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>N</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>ALUOP A B N

declare N = (FLAG &gt;&gt; 1) &amp; 0b1;

# Test all zero cases
0b000 0 0 0 # AND
0b001 0 0 0 # SUB
0b010 0 0 1 # NAND
0b011 0 0 1 # NOR
0b100 0 0 0 # AND
0b101 0 0 0 # ORR
0b110 0 0 0 # XOR
0b111 0 0 1 # NOT

# Test 1 + (-1) = 0
0b000 1 0xFFFF 0

# Test random inputs
loop(i, 200)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);

    (0b000) (a) (b) (((a + b) &amp; 0xFFFF) &gt;&gt; 15)   # ADD
    (0b001) (a) (b) (((a - b) &amp; 0xFFFF) &gt;&gt; 15)   # SUB
    (0b010) (a) (b) ((~(a &amp; b) &amp; 0xFFFF) &gt;&gt; 15)  # NAND
    (0b011) (a) (b) ((~(a | b) &amp; 0xFFFF) &gt;&gt; 15)  # NOR
    (0b100) (a) (b) ((a &amp; b) &gt;&gt; 15)              # AND
    (0b101) (a) (b) ((a | b) &gt;&gt; 15)              # ORR
    (0b110) (a) (b) ((a ^ b) &gt;&gt; 15)              # XOR
    (0b111) (a) (b) (((~a) &amp; 0xFFFF) &gt;&gt; 15)        # NOT
end loop</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-300" y="260"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>C</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>ALUOP A B C

declare C = (FLAG &gt;&gt; 3) &amp; 0b1;

# Test 0 + 0
0b000 0 0 0

# (0 - 0) is implemented as 0 + (0xFFFF + 1), so a carry is expected
0b001 0 0 1

# Carry should propagate all the way from the first bit if necessary
0b000 1 0xFFFF 1

# Adding 15 bit values should never carry
loop(i, 100)
    0b000 (random(1 &lt;&lt; 15)) (random(1 &lt;&lt; 15)) 0
end loop

# Test random inputs
loop(i, 200)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);

    0b000 (a) (b) (((a + b) &gt;&gt; 16) &amp; 0b1)
    0b001 (a) (b) (~((a - b) &gt;&gt; 16) &amp; 0b1)
end loop

# Other operations will not set the C flag.
loop(i, 100)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);
    0b010 (a) (b) 0
    0b011 (a) (b) 0
    0b100 (a) (b) 0
    0b101 (a) (b) 0
    0b110 (a) (b) 0
    0b111 (a) (b) 0
end loop
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-300" y="500"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>V</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>ALUOP A B V

declare V = (FLAG &gt;&gt; 2) &amp; 0b1;

# Test zero cases for + / -
0b000 0 0 0
0b001 0 0 0

# 1 + (-1) = 0  ; different input signs = no overflow here!
0b000 1 0xFFFF 0

# 3 - 5 = 3 + (-5) = -2  ; subtraction inverts the second operand sign
0b001 3 5 0

# Some edge cases when subtracting 0x8000
0b001 0x8000 0x8000 0
0b001 0xFFFF 0x8000 0
0b001 0x7FFF 0x8000 1

# Test random inputs
loop(i, 200)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);

    0b000 (a) (b) (((~(a ^ b) &amp; (a ^ (a + b))) &gt;&gt; 15) &amp; 0b1)
    0b001 (a) (b) (((~(a ^ ~b) &amp; (a ^ (a - b))) &gt;&gt; 15) &amp; 0b1)
end loop

# Other operations will not set the overflow flag.
loop(i, 100)
    let a = random(1 &lt;&lt; 16);
    let b = random(1 &lt;&lt; 16);
    0b010 (a) (b) 0
    0b011 (a) (b) 0
    0b100 (a) (b) 0
    0b101 (a) (b) 0
    0b110 (a) (b) 0
    0b111 (a) (b) 0
end loop
</dataString>
          </testData>
        </entry>
